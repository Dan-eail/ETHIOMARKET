datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles         UserRole[]
  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  transporterProfile TransporterProfile?

  productsSelling Product[]
  quotesSubmitted Quote[]   @relation("BuyerQuotes")
  quotesReceived  Quote[]   @relation("SellerQuotes")
  ordersBought    Order[]   @relation("BuyerOrders")
  ordersSold      Order[]   @relation("SellerOrders")
  notifications   Notification[]
  auditLogs       AuditLog[]
  reviewsGiven    Review[]  @relation("Reviewer")
  reviewsReceived Review[]  @relation("ReviewedUser")
  favorites       Favorite[]
  verificationRecords VerificationRecord[]
  kycReviewsProcessed VerificationRecord[] @relation("KYCReviewer")
  paymentsMade        Payment[]
  refundsRequested    RefundRecord[]       @relation("RefundRequester")
  refundsProcessed    RefundRecord[]       @relation("RefundProcessor")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  role       String   // FARMER, BUYER, TRANSPORTER, ADMIN
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model FarmerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  farmName            String
  region              String   // Oromia, Amhara, Sidama, SNNPR, etc.
  zone                String?
  woreda              String?
  kebele              String?
  farmSizeHectares    Float?
  experienceYears     Int?
  organicCertified    Boolean  @default(false)
  bio                 String?
  verifiedBadge       Boolean  @default(false)

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BuyerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  businessName  String
  businessType  String   // WHOLESALER, RETAILER, RESTAURANT, EXPORTER, INDIVIDUAL
  tinNumber     String?
  region        String
  city          String
  deliveryAddress String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TransporterProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  companyName    String
  licenseNumber  String?
  regionsCovered String?   // Comma separated or JSON string
  verified       Boolean   @default(false)
  rating         Float     @default(5.0)

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]
  deliveries     Delivery[]
}

model Vehicle {
  id             String    @id @default(cuid())
  transporterId  String
  plateNumber    String    @unique
  vehicleType    String    // PICKUP, ISUZU, FSR, TRAILER, REFRIGERATED
  capacityTons   Float
  modelYear      Int?
  active         Boolean   @default(true)
  verified       Boolean   @default(false)

  transporter    TransporterProfile @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  deliveries     Delivery[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?   // Lucide icon name or emoji
  imageUrl    String?

  products    Product[]
}

model Product {
  id                 String    @id @default(cuid())
  sellerId           String
  categoryId         String
  title              String
  slug               String?
  description        String
  variety            String?   // e.g., 'Magna Teff', 'Sidama Heirloom'
  grade              String?   // 'Grade 1 Export', 'Standard Commercial'
  harvestDate        DateTime?
  unit               String    // KG, QUINTAL, TON, CRATE, SACK
  pricePerUnit       Float     // Numerical in ETB
  currency           String    @default("ETB")
  minOrderQty        Float     @default(1)
  availableQty       Float     // Current stock
  reservedQty        Float     @default(0)
  soldQty            Float     @default(0)
  lowStockThreshold  Float     @default(10)
  region             String
  city               String
  specificLocation   String?
  status             String    @default("PUBLISHED") // DRAFT, PUBLISHED, PAUSED, SOLD_OUT, ARCHIVED
  isOrganic          Boolean   @default(false)
  featured           Boolean   @default(false)
  viewsCount         Int       @default(0)
  inquiriesCount     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  seller             User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category           Category      @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  quotes             Quote[]
  orderItems         OrderItem[]
  favorites          Favorite[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Quote {
  id                String         @id @default(cuid())
  quoteNumber       String         @unique
  buyerId           String
  sellerId          String
  productId         String
  requestedQty      Float
  requestedPrice    Float          // Initial buyer offer per unit
  offeredPrice      Float?         // Latest counter price per unit
  finalPrice        Float?         // Agreed price per unit
  unit              String         @default("KG")
  currency          String         @default("ETB")
  note              String?
  counterpartyNote  String?
  status            String         @default("PENDING") // PENDING, COUNTERED, ACCEPTED, REJECTED, EXPIRED, WITHDRAWN
  expiresAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  buyer             User           @relation("BuyerQuotes", fields: [buyerId], references: [id])
  seller            User           @relation("SellerQuotes", fields: [sellerId], references: [id])
  product           Product        @relation(fields: [productId], references: [id])
  history           QuoteHistory[]
  orders            Order[]
}

model QuoteHistory {
  id            String   @id @default(cuid())
  quoteId       String
  senderId      String
  senderRole    String   // BUYER, SELLER
  proposedPrice Float
  proposedQty   Float
  note          String?
  createdAt     DateTime @default(now())

  quote         Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  buyerId                String
  sellerId               String
  quoteId                String?
  invoiceNumber          String?
  totalAmount            Float       // In ETB
  subtotal               Float
  deliveryFee            Float       @default(0)
  currency               String      @default("ETB")
  status                 String      @default("CONFIRMED") // PENDING_PAYMENT, CONFIRMED, PROCESSING, READY_FOR_PICKUP, IN_TRANSIT, DELIVERED, CANCELLED, DISPUTED
  paymentStatus          String      @default("CASH_ON_DELIVERY") // PENDING, PAID, CASH_ON_DELIVERY, REFUNDED
  paymentMethod          String      @default("CASH_ON_DELIVERY") // CASH_ON_DELIVERY, TELEBIRR, CBE_BIRR, BANK_TRANSFER
  paymentReference       String?
  isPaid                 Boolean     @default(false)
  deliveryAddressSnapshot String
  notes                  String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  buyer                  User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller                 User        @relation("SellerOrders", fields: [sellerId], references: [id])
  quote                  Quote?      @relation(fields: [quoteId], references: [id])
  items                  OrderItem[]
  delivery               Delivery?
  review                 Review?
  disputes               Dispute[]
  payments               Payment[]
  refunds                RefundRecord[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productUnit String
  quantity    Float
  unitPrice   Float
  totalPrice  Float

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Delivery {
  id                      String              @id @default(cuid())
  deliveryNumber          String              @unique
  orderId                 String              @unique
  transporterId           String?
  vehicleId               String?
  pickupRegion            String
  pickupCity              String
  pickupAddress           String
  dropoffRegion           String
  dropoffCity             String
  dropoffAddress          String
  cargoWeightQuintals     Float               @default(10)
  distanceKm              Float?
  deliveryFee             Float               @default(0)
  estimatedPickupDate     DateTime?
  estimatedDeliveryDate    DateTime?
  pickupVerificationCode  String?             // 6-digit secure code generated for farm pickup
  deliveryVerificationCode String?            // 6-digit secure code generated for customer delivery
  isPickupVerified        Boolean             @default(false)
  isDeliveryVerified      Boolean             @default(false)
  cargoSealNumber         String?
  reportedDelayReason     String?
  status                  String              @default("REQUESTED") // REQUESTED, QUOTED, ASSIGNED, PICKED_UP, IN_TRANSIT, DELIVERED, CANCELLED
  proofOfDeliveryUrl      String?
  recipientName           String
  recipientPhone          String
  notes                   String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transporter          TransporterProfile? @relation(fields: [transporterId], references: [id])
  vehicle              Vehicle?            @relation(fields: [vehicleId], references: [id])
  events               DeliveryEvent[]
}

model DeliveryEvent {
  id          String   @id @default(cuid())
  deliveryId  String
  status      String
  description String
  location    String?
  timestamp   DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String    @id @default(cuid())
  participant1Id String
  participant2Id String
  topic         String?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages      Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String