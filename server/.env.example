PORT=5000
DATABASE_URL="file:./dev.db" # Or postgresql://user:password@localhost:5432/ethiomarket?schema=public
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"
CLIENT_ORIGIN="http://localhost:5173"

# Fayda National e-KYC Integration (eSignet / MOSIP OIDC 1.0)
# Register Relying Party on https://partner.fayda.et to obtain official sandbox/production credentials
FAYDA_ISSUER="https://id.gov.et"
FAYDA_AUTH_URL="https://id.gov.et/authentication"
FAYDA_TOKEN_URL="https://partner.fayda.et/oauth2/token"
FAYDA_USERINFO_URL="https://partner.fayda.et/oauth2/userinfo"
FAYDA_JWKS_URL="https://partner.fayda.et/oauth2/jwks"
FAYDA_CLIENT_ID=""
FAYDA_CLIENT_SECRET=""
FAYDA_REDIRECT_URI="http://localhost:5173/kyc/fayda/callback"
KYC_STORAGE_DIR="./uploads/kyc_documents"

# Chapa Payments Integration (Merchant Account)
CHAPA_API_BASE_URL="https://api.chapa.co/v1"
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""
CHAPA_WEBHOOK_URL="http://localhost:5000/api/v1/payments/webhook"
CHAPA_RETURN_URL="http://localhost:5173/checkout/verify"
PAYMENT_ENVIRONMENT="test"
